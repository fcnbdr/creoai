# ========================================
# 数据库配置
# ========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aivideo
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ========================================
# Redis配置
# ========================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ========================================
# OpenAI API配置（可选）
# ========================================
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# ========================================
# 对象存储配置（阿里云OSS）
# ========================================
OSS_ACCESS_KEY_ID=your_access_key
OSS_ACCESS_KEY_SECRET=your_secret
OSS_BUCKET=your-bucket
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou

# ========================================
# DeepSeek API配置
# ========================================
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat

# ========================================
# ECPro API配置（需向极睿科技申请）
# ========================================
ECPRO_API_BASE_URL=https://aigc-next.ecpro.com/api
ECPRO_API_KEY=your-ecpro-key

# ========================================
# iClip MCP API配置
# ========================================
ICLIP_API_BASE_URL=https://aigc-next.iclip.cn/api
ICLIP_API_KEY=your-iclip-key

# ========================================
# Stable Diffusion API配置（自研模式）
# ========================================
SD_API_URL=http://localhost:7860
SD_API_KEY=your-sd-key

# ========================================
# SkyReels-V3 API配置（自研模式）
# ========================================
SKYREELS_API_URL=http://localhost:8080

# ========================================
# TapNow AI API配置
# ========================================
TAPNOW_API_KEY=your-tapnow-key

# ========================================
# JWT认证配置
# ========================================
JWT_SECRET_KEY=change-this-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================================
# 管理员初始账号
# ========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ========================================
# 系统配置
# ========================================
MAX_VIDEO_SIZE_MB=200
DAILY_VIDEO_LIMIT=10
DAILY_TOKEN_LIMIT=1000000
DAILY_ICLIP_POINT_LIMIT=100

# ========================================
# 前端配置
# ========================================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
